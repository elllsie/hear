# Public project URL is safe to keep in this example.
SUPABASE_URL=https://frljmdtogeyajpbwjavv.supabase.co

# Backend secret: copy the service_role key from Supabase Dashboard >
# Project Settings > API. Never put this value in the iOS app or Git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional LibreTranslate-compatible endpoint. When unset, backend translation
# is skipped and iOS 18 system translation is used on demand.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Optional AI-generated episode summaries and difficult words. Secrets stay in
# backend/.env only. Supported providers: openai, openai_compatible.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120
# Neural voices used by generate_word_audio_replacements.py
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice overrides:
# AZURE_SPEECH_VOICE_de_DE=de-DE-KatjaNeural
# AZURE_SPEECH_VOICE_en_US=en-US-JennyNeural
# AZURE_SPEECH_VOICE_zh_CN=zh-CN-XiaoxiaoNeural
